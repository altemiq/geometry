<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Altemiq.Runtime" Version="1.3.0" Condition=" $([MSBuild]::GetTargetFrameworkIdentifier($(TargetFramework))) != '.NETFramework' " />
    <PackageVersion Include="Altemiq.Grpc.Tools" Version="1.0.0" />
    <PackageVersion Include="Altemiq.Protobuf" Version="1.0.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.35.1" />
    <PackageVersion Include="Grpc.Tools" Version="2.81.1" />
    <PackageVersion Include="NuGet.Configuration" Version="7.6.0" />
    <PackageVersion Include="Spatialite" Version="5.1.0" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageVersion Include="TUnit" Version="1.56.35" />
  </ItemGroup>

  <ItemGroup>
    <GlobalPackageReference Include="Meziantou.Polyfill" Version="1.0.154" />
  </ItemGroup>

  <Choose>
    <When Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
      <ItemGroup>
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.9" />
        <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.0.9" />
        <PackageVersion Include="System.Text.Encoding.CodePages" Version="10.0.9" />
        <PackageVersion Include="System.Text.Json" Version="10.0.9" />
      </ItemGroup>
    </When>
    <When Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net9.0'))">
      <ItemGroup>
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="9.0.16" />
        <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="9.0.16" />
        <PackageVersion Include="System.Text.Encoding.CodePages" Version="9.0.16" />
        <PackageVersion Include="System.Text.Json" Version="9.0.16" />
      </ItemGroup>
    </When>
    <When Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
      <ItemGroup>
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="8.0.27" />
        <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="8.0.2" />
        <PackageVersion Include="System.Text.Encoding.CodePages" Version="8.0.0" />
        <PackageVersion Include="System.Text.Json" Version="8.0.6" />
      </ItemGroup>
    </When>
    <When Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">
      <ItemGroup>
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="7.0.20" />
        <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="7.0.0" />
        <PackageVersion Include="System.Text.Encoding.CodePages" Version="7.0.0" />
        <PackageVersion Include="System.Text.Json" Version="7.0.4" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="6.0.36" />
        <PackageVersion Include="System.Text.Encoding.CodePages" Version="6.0.1" />
      </ItemGroup>
    </Otherwise>
  </Choose>

</Project>
